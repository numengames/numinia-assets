    "voice": {
      "default_db": 0,
      "note": "Reference level. Nothing else is ever louder; voice chat never ducked."
    },
    "effects": {
      "default_db": -6,
      "user_slider": true
    },
    "ui": {
      "default_db": -6,
      "user_slider": true
    },
    "ambient": {
      "default_db": -6,
      "user_slider": true
    },
    "music": {
      "default_db": -8,
      "user_slider": true,
      "default_track": null
    }
  },
  "budget": {
    "format": "ogg/opus mono 48 kbps (ambient loops stereo not required)",
    "per_effect_max_kB": 40,
    "total_effects_max_kB": 450,
    "per_loop_max_kB": 120,
    "voices_max_desktop": 12,
    "voices_max_phone": 6,
    "load": "lazy by station; never part of the first-draw page budget",
    "status": "design targets, not measured"
  },
